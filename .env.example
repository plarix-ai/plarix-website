# Copy to .env.local for local work, and set the same names in the host
# (Vercel: Project, Settings, Environment Variables) for production.
# Nothing here is read at build time except the two verification tokens,
# so changing those needs a redeploy before a search console will see them.

# Lead capture. Without both of these the /count form answers 503 and the
# page falls back to the email address, which is deliberate: it never
# silently drops a submission.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Search console ownership. Paste only the token, not the whole meta tag.
# Google Search Console, Add property, plarix.dev, HTML tag method: the
# token is the content="..." value.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools, HTML meta tag method: the msvalidate.01 value.
BING_SITE_VERIFICATION=
